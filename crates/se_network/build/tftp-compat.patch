 #include <sys/types.h>
 #include <sys/stat.h>
 #include <fcntl.h>
 
+/* Downstream adaptation: a TFTP file name is a UTF-8 host path, and GLib
+ * resolves it so that non-ASCII names also reach the Windows filesystem. */
+#include <glib/gstdio.h>
+
+#define TFTP_IP12_PROM_TRAILER_LEN 4
+
 #if defined(_WIN32)
 #include <io.h>
 #include <share.h>
 #endif
 
+static bool tftp_options_are_valid(const char *options, size_t length)
+{
+    const char *end = options + length;
+
+    while (options < end) {
+        const char *terminator = memchr(options, '\0', end - options);
+
+        if (!terminator || terminator == options) {
+            return false;
+        }
+        options = terminator + 1;
+        terminator = memchr(options, '\0', end - options);
+        if (!terminator || terminator == options) {
+            return false;
+        }
+        options = terminator + 1;
+    }
+
+    return true;
+}
